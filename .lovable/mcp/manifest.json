{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rswkiivvkhjqwmzcwezw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "ganespic-xxv-gallery",
      "version": "0.1.0",
      "title": "Ganespic XXV Gallery"
    },
    "tools": [
      {
        "name": "list_activities",
        "title": "List activities",
        "description": "List all Ganespic XXV gallery activities (kegiatan) with grade level, era, date and photo count.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "era": {
              "description": "Filter by era: mts (kelas 7-9) or ma (kelas 10-12).",
              "type": "string",
              "enum": [
                "mts",
                "ma"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_activity",
        "title": "Get activity",
        "description": "Get one activity by slug or id, including its full description and all photos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "description": "Activity slug, e.g. 'matsama-kelas-7'.",
              "type": "string"
            },
            "id": {
              "description": "Activity UUID. Used when slug is omitted.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_activity",
        "title": "Create activity",
        "description": "Create a new gallery activity (kegiatan). Requires the connected user to be an archive admin.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Activity title in Indonesian, e.g. 'Class Meeting Kelas 8'."
            },
            "grade_level": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Grade level from 7 to 12."
            },
            "description": {
              "description": "Narrative description of the activity.",
              "type": "string"
            },
            "activity_date": {
              "description": "Date as YYYY-MM-DD.",
              "type": "string"
            }
          },
          "required": [
            "title",
            "grade_level"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_activity",
        "title": "Update activity",
        "description": "Update an existing activity's title, description, grade level, date, or cover image. Admin only.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Activity UUID."
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "grade_level": {
              "description": "Grade level 7-12; era is derived from it.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "activity_date": {
              "description": "Date as YYYY-MM-DD.",
              "type": "string"
            },
            "cover_image_url": {
              "description": "Absolute https URL for the cover photo.",
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "add_photo",
        "title": "Add photo to activity",
        "description": "Attach a photo to an activity using an absolute image URL (cloud link or CDN). Admin only.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "activity_id": {
              "type": "string",
              "description": "Activity UUID the photo belongs to."
            },
            "image_url": {
              "type": "string",
              "description": "Absolute https URL of the image."
            },
            "caption": {
              "description": "Short Indonesian caption.",
              "type": "string"
            },
            "make_cover": {
              "description": "Also set this photo as the activity cover.",
              "type": "boolean"
            }
          },
          "required": [
            "activity_id",
            "image_url"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "delete_photo",
        "title": "Delete photo",
        "description": "Permanently remove a photo from an activity by its photo id. Admin only.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "photo_id": {
              "type": "string",
              "description": "Photo UUID to delete."
            }
          },
          "required": [
            "photo_id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
